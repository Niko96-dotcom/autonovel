# Text-model backend: "anthropic" or any OpenAI-compatible server.
AUTONOVEL_LLM_PROVIDER=anthropic
AUTONOVEL_API_BASE_URL=https://api.anthropic.com

# Use a direct key, a provider-specific legacy key, or a local key file.
ANTHROPIC_API_KEY=sk-ant-...
# AUTONOVEL_API_KEY=...
# AUTONOVEL_API_KEY_FILE=/absolute/path/to/api-key

# Writer, judge, and whole-book reviewer can be different models.
AUTONOVEL_WRITER_MODEL=claude-sonnet-4-6
AUTONOVEL_JUDGE_MODEL=claude-sonnet-4-6
AUTONOVEL_REVIEW_MODEL=claude-opus-4-6

# Used for safe output budgeting and hierarchical whole-manuscript review.
AUTONOVEL_CONTEXT_SIZE=1000000
AUTONOVEL_REQUEST_TIMEOUT=600
AUTONOVEL_TOOL_TIMEOUT=600
AUTONOVEL_BATCH_TIMEOUT=1800

# Local llama.cpp example:
# AUTONOVEL_LLM_PROVIDER=openai
# AUTONOVEL_API_BASE_URL=http://127.0.0.1:8081
# AUTONOVEL_API_KEY_FILE=/absolute/path/to/llama-api-key
# AUTONOVEL_WRITER_MODEL=gemstrike-31b
# AUTONOVEL_JUDGE_MODEL=gemstrike-31b
# AUTONOVEL_REVIEW_MODEL=gemstrike-31b
# AUTONOVEL_CONTEXT_SIZE=32768
# AUTONOVEL_REQUEST_TIMEOUT=1800
# AUTONOVEL_TOOL_TIMEOUT=1800
# AUTONOVEL_BATCH_TIMEOUT=21600

# Optional non-text services. Local LLM support does not replace these.
FAL_KEY=your-fal-api-key-here
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
